// Cloudflare Workers template for the SWS Studio Control Plane (v0.2.0).
// Copy as `wrangler.jsonc` in your Studio deployment directory and replace placeholder IDs.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sws-studio-control-plane",
	// worker-build emits build/index.js + index_bg.wasm for the Studio Control Plane Worker.
	"main": "crates/sws-worker-studio/build/index.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"build": {
		// Requires: cargo install worker-build@^0.9 --locked
		"command": "cd crates/sws-worker-studio && worker-build --release",
		"watch_dir": "crates/sws-worker-studio/src"
	},
	"d1_databases": [
		{
			"binding": "STUDIO_DB",
			"database_name": "sws-studio-db",
			"migrations_dir": "crates/sws-worker-studio/migrations",
			"database_id": "<YOUR_STUDIO_D1_DATABASE_ID>"
		}
	],
	// Per-site command sessions (#62): one SQLite-backed, hibernating Durable Object per
	// site (class SiteSession, id derived from workspace_id/site_id). SQLite-backed classes
	// are available on the Workers Free plan, so this keeps the cardless default. Never change
	// the class name or reuse a migration tag after deploying: add a new migration instead.
	"durable_objects": {
		"bindings": [{ "name": "SITE_SESSION", "class_name": "SiteSession" }]
	},
	"migrations": [{ "tag": "v1-site-session", "new_sqlite_classes": ["SiteSession"] }],
	// Cardless default: D1 + Durable Objects + vars only. Opt-in/later bindings (add them only when the
	// owning issue ships and you accept any billing implications):
	//   R2 media          (#63, OPT-IN, may require a payment method on your Cloudflare account):
	//                            "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "sws-studio-media" }]
	//                            AND the var "STUDIO_ASSET_BACKEND": "r2". Both are needed; the var without the
	//                            binding answers 503 r2_not_configured (no silent fallback). Create the bucket
	//                            yourself (`wrangler r2 bucket create`); nothing in this repo does it for you.
	//                            Leave both unset for the cardless default: size-capped D1 blobs
	//                            (1 MiB/asset, 50 MiB/site, 150 MiB/workspace; provisional limits).
	//   R2 bundles        (#64): "r2_buckets": [{ "binding": "BUNDLES_BUCKET", "bucket_name": "sws-studio-bundles" }]
	// Asset caps (and any alerts you add) reduce billing risk but are NOT provider-side hard stops;
	// set your own Cloudflare usage notifications. See docs/ARCHITECTURE.md, "Studio asset storage".
	//   Queues publish    (#64): "queues": { "producers": [{ "binding": "PUBLISH_QUEUE", "queue": "sws-studio-publish" }],
	//                            "consumers": [{ "queue": "sws-studio-publish", "max_retries": 3, "dead_letter_queue": "sws-studio-publish-dlq" }] }
	"vars": {
		"STUDIO_VERSION": "0.2.0-dev",
		"STUDIO_PUBLIC_ORIGIN": "https://studio.sws.example",
		"PUBLISHED_ORIGIN_TEMPLATE": "https://{slug}.sws.example",
		// GitHub OAuth App client id (public, non-secret); consumed by #65.
		"GITHUB_OAUTH_CLIENT_ID": "<YOUR_GITHUB_OAUTH_CLIENT_ID>",
		// Cloudflare Turnstile always-pass TEST site key (dev only). Replace in production.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// Optional session tuning (#62), clamped by the Worker; defaults shown.
		// Membership is re-read from D1 before every edit; a socket not verified for twice
		// SESSION_AUTHZ_RECHECK_MS (cap 30000 ms, so 60 s) is sent nothing. The idle sweep alarm
		// (default 60000 ms, clamped to max(1000, SESSION_AUTHZ_RECHECK_MS)..60000) only closes idle
		// removed members (within that plus one D1 read) and is kept long so the object can
		// hibernate. Presence entries expire after the TTL.
		"SESSION_AUTHZ_RECHECK_MS": "15000",
		"SESSION_IDLE_SWEEP_MS": "60000",
		"SESSION_PRESENCE_TTL_MS": "30000"
	},
	// Secrets (never commit): set with `wrangler secret put <NAME>` in production,
	// or in `.dev.vars` for local `wrangler dev`:
	//   GITHUB_OAUTH_CLIENT_SECRET  secret; GitHub OAuth App client secret (consumed by #65)
	//   SESSION_SIGNING_KEY         (future, #65) signing key for Studio auth sessions; not read by the current scaffold
	//   TURNSTILE_SECRET_KEY        (future, #65) not read by the current scaffold; no route uses it yet
	//   CLOUDFLARE_DEPLOY_API_TOKEN opt-in (#64); required only for remote publish jobs
	// Future (#65), not read by the current scaffold: a local-only DEV_MODE="true" in `.dev.vars`
	// to relax Turnstile verification. Do not rely on it until that issue ships.
	"observability": {
		"enabled": true
	}
}
