// Local/dev Wrangler config for the optional Studio Worker (sws-worker-studio).
// Deliberately SEPARATE from ./wrangler.jsonc (the visitor Worker): different
// Worker name, build output, D1 binding/database, and local state directory
// (`--persist-to .wrangler/studio-state` in the npm scripts). The local D1
// placeholder id below is also distinct from the visitor Worker's, because local
// D1 state is keyed by `database_id`: even a direct `wrangler ... --local -c
// wrangler.studio.jsonc` without `--persist-to` cannot touch the visitor's local DB.
// Production template: deploy/cloudflare/wrangler.studio.example.jsonc.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sws-studio-control-plane",
	"main": "crates/sws-worker-studio/build/index.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"build": {
		// Requires: cargo install worker-build@0.9.0 --locked (pinned in wasm-toolchain.json).
		"command": "node scripts/build-wasm.mjs --profile release --crate crates/sws-worker-studio",
		"watch_dir": "crates/sws-worker-studio/src"
	},
	"d1_databases": [
		{
			"binding": "STUDIO_DB",
			"database_name": "sws-studio-db",
			"migrations_dir": "crates/sws-worker-studio/migrations",
			// Local placeholder ID; replace with your `wrangler d1 create` output before deploying.
			"database_id": "00000000-0000-0000-0000-000000000061"
		}
	],
	// Per-site command sessions (#62): one SQLite-backed, hibernating Durable Object per
	// site. Free-plan compatible (SQLite-backed classes only). The route
	// /api/sites/{workspace_id}/{site_id}/session answers 401 until real auth (#65) lands.
	"durable_objects": {
		"bindings": [{ "name": "SITE_SESSION", "class_name": "SiteSession" }]
	},
	"migrations": [{ "tag": "v1-site-session", "new_sqlite_classes": ["SiteSession"] }],
	// Non-secret vars only. Secrets (SESSION_SIGNING_KEY, GITHUB_OAUTH_CLIENT_SECRET, ...)
	// belong in `.dev.vars` locally or `wrangler secret put` in production (#65).
	"vars": {
		"STUDIO_VERSION": "0.2.0-dev",
		"STUDIO_PUBLIC_ORIGIN": "http://127.0.0.1:8788"
	},
	"observability": {
		"enabled": true
	}
}
