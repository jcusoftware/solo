{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-website-system.example/packs/hospitality/schema/venue.schema.json",
  "title": "SWS venue manifest",
  "description": "Tenant-agnostic hospitality manifest consumed by sws-pack-hospitality and sws-cli.",
  "type": "object",
  "required": ["schema_version", "slug", "name", "business_types", "nap", "hours", "brand", "modules", "integrations", "menu"],
  "additionalProperties": false,
  "$defs": {
    "hhmm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "day": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] },
    "dayHours": {
      "oneOf": [
        {
          "type": "object",
          "required": ["opens", "closes"],
          "additionalProperties": false,
          "properties": { "opens": { "$ref": "#/$defs/hhmm" }, "closes": { "$ref": "#/$defs/hhmm" } }
        },
        {
          "type": "object",
          "required": ["closed"],
          "additionalProperties": false,
          "properties": { "closed": { "const": true } }
        }
      ]
    },
    "module": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" }, "name": { "type": "string" } }
    },
    "menuItem": {
      "type": "object",
      "required": ["name", "price"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "price": {
          "oneOf": [
            { "$ref": "#/$defs/price" },
            { "type": "null" }
          ]
        },
        "price_note": { "type": "string", "maxLength": 120 },
        "contains_alcohol": { "type": "boolean" },
        "dietary": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["vegan", "vegetarian", "gluten-free", "dairy-free", "halal", "kosher", "low-salt"] }
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "legal_disclaimer": { "type": ["string", "null"], "description": "Shown visibly on every page when present." },
    "fictional": { "type": "boolean" },
    "tagline": { "type": "string" },
    "description": { "type": "string" },
    "category_label": { "type": "string" },
    "business_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$", "description": "schema.org LocalBusiness subtype" }
    },
    "cuisine": { "type": "array", "items": { "type": "string" } },
    "price_range": { "type": "string", "pattern": "^\\${1,4}$" },
    "locale": { "type": "string" },
    "timezone": { "type": "string" },
    "nap": {
      "type": "object",
      "required": ["name", "address", "phone", "email", "website"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "address": {
          "type": "object",
          "required": ["street", "locality", "region", "postal_code", "country"],
          "additionalProperties": false,
          "properties": {
            "street": { "type": "string" },
            "locality": { "type": "string" },
            "region": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "postal_code": { "type": "string" },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
          }
        },
        "phone": { "type": "string", "pattern": "^\\+[0-9-]{7,20}$" },
        "email": { "type": "string", "format": "email" },
        "website": { "type": "string", "pattern": "^https://" }
      }
    },
    "geo": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "additionalProperties": false,
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "approximate": { "type": "boolean" }
      }
    },
    "hours": {
      "type": "object",
      "required": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
      "additionalProperties": false,
      "patternProperties": { "^(mon|tues|wednes|thurs|fri|satur|sun)day$": { "$ref": "#/$defs/dayHours" } }
    },
    "holiday_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "label"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "label": { "type": "string" },
          "closed": { "type": "boolean" },
          "opens": { "$ref": "#/$defs/hhmm" },
          "closes": { "$ref": "#/$defs/hhmm" }
        },
        "oneOf": [
          {
            "required": ["closed"],
            "properties": { "closed": { "const": true } },
            "not": { "anyOf": [{ "required": ["opens"] }, { "required": ["closes"] }] }
          },
          {
            "required": ["opens", "closes"],
            "properties": { "closed": { "const": false } }
          }
        ]
      }
    },
    "booking_url": { "type": ["string", "null"], "pattern": "^https://" },
    "venue_accessibility": { "type": "array", "items": { "type": "string" } },
    "brand": {
      "type": "object",
      "required": ["palette", "contrast", "fonts"],
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "object",
          "required": ["background", "text", "accent"],
          "additionalProperties": { "$ref": "#/$defs/hex" }
        },
        "contrast": {
          "type": "object",
          "required": ["pairs"],
          "additionalProperties": false,
          "properties": {
            "wcag_target": { "type": "string" },
            "pairs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["foreground", "background", "ratio"],
                "additionalProperties": false,
                "properties": {
                  "foreground": { "type": "string", "description": "palette key" },
                  "background": { "type": "string", "description": "palette key" },
                  "ratio": { "type": "number", "minimum": 4.5 },
                  "usage": { "type": "string" }
                }
              }
            }
          }
        },
        "fonts": {
          "type": "object",
          "required": ["body"],
          "additionalProperties": false,
          "properties": {
            "body": { "type": "string", "description": "System font stack only; no web fonts." },
            "heading": { "type": "string" }
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^M([1-9]|10)$": { "$ref": "#/$defs/module" } }
    },
    "integrations": {
      "type": "object",
      "required": ["seating_policy"],
      "additionalProperties": false,
      "properties": {
        "toast": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "restaurant_guid": { "type": ["string", "null"] }
          }
        },
        "seating_policy": { "enum": ["walk_in_only", "opentable", "resy"] },
        "opentable": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "restaurant_id": { "type": ["string", "null"] } }
        },
        "resy": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "venue_id": { "type": ["string", "null"] } }
        },
        "inkind": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "turnstile": {
          "type": "object",
          "required": ["site_key"],
          "additionalProperties": false,
          "properties": { "site_key": { "type": "string" }, "test_key": { "type": "boolean" } }
        }
      }
    },
    "newsletter": {
      "type": "object",
      "required": ["enabled", "consent_text"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "blurb": { "type": "string", "maxLength": 500 },
        "consent_text": { "type": "string", "maxLength": 500 },
        "privacy_note": { "type": "string" }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "source", "google_calendar_id", "timezone"],
          "if": { "properties": { "enabled": { "const": true }, "source": { "const": "google_calendar_sync" } } },
          "then": { "properties": { "google_calendar_id": { "type": "string", "pattern": "\\S" } } },
          "properties": {
            "enabled": { "type": "boolean" },
            "source": { "enum": ["d1_or_cms", "google_calendar_sync"] },
            "google_calendar_id": { "type": ["string", "null"], "minLength": 1 },
            "timezone": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "happy_hour": {
      "type": "object",
      "required": ["days", "start", "end", "offers"],
      "additionalProperties": false,
      "properties": {
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" }, "uniqueItems": true },
        "start": { "$ref": "#/$defs/hhmm" },
        "end": { "$ref": "#/$defs/hhmm" },
        "offers": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "menu": {
      "type": "object",
      "required": ["name", "currency", "sections"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "items"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "name": { "type": "string" },
              "description": { "type": "string", "maxLength": 500 },
              "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/menuItem" } }
            }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 70 },
        "description": { "type": "string", "maxLength": 160 },
        "routes": { "type": "array", "items": { "type": "string", "pattern": "^/" } }
      }
    }
  }
}
