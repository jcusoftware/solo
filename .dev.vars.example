# Copy to .dev.vars for local `wrangler dev` (never commit .dev.vars).
# Cloudflare Turnstile always-pass TEST secret (pairs with site key 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Leave empty to stub email dispatch ("resend stub: skipped").
RESEND_API_KEY=
# Local development only: allows the TEST dummy secret above. With DEV_MODE unset,
# a TEST secret is rejected with 503 (fail closed) — production must replace the
# TEST secret via `wrangler secret put TURNSTILE_SECRET_KEY` and must NOT set this.
DEV_MODE=true
