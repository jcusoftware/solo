# Copy to .dev.vars for local `wrangler dev` (never commit .dev.vars).
# Cloudflare Turnstile always-pass TEST secret (pairs with site key 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Leave empty to stub email dispatch ("resend stub: skipped").
RESEND_API_KEY=
# Local development only: allows the TEST dummy secret above. With DEV_MODE unset,
# a TEST secret is rejected with 503 (fail closed) — production must replace the
# TEST secret via `wrangler secret put TURNSTILE_SECRET_KEY` and must NOT set this.
DEV_MODE=true

# --- Sandbox demo checkout (all optional; checkout is unavailable without them) ---
# Non-secret var: exact public origin of the rendered site (no path). Loopback
# http (127.0.0.1/localhost) is accepted for local testing only.
DEMO_CHECKOUT_ORIGIN=http://127.0.0.1:8787
# Non-secret var: JSON object mapping each demo checkout item id (including the
# subscription) to its sandbox Stripe Price id, e.g.
# {"flatbread":"price_REPLACE","soup":"price_REPLACE","cookie":"price_REPLACE","beans":"price_REPLACE"}
STRIPE_DEMO_PRICE_IDS=
# SECRET (never commit): sandbox Stripe restricted/secret key; only prefixes
# sk_test_ / rk_test_ are accepted. Set with `wrangler secret put` in production.
STRIPE_DEMO_SECRET_KEY=

# --- Call booking (issue #44; all optional; /api/bookings answers 503 fail-closed
# without GOOGLE_BOOKING_CALENDAR_ID) ---
# Primary calendar ID of the Workspace user mailbox booking lives on.
GOOGLE_BOOKING_CALENDAR_ID=
# Optional Zoom meeting creation (auto_zoom): Server-to-Server OAuth app.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
# SECRET (never commit): Zoom Server-to-Server OAuth client secret.
ZOOM_CLIENT_SECRET=
# Opaque Zoom host user ID (never an email, never "me").
ZOOM_HOST_USER_ID=
