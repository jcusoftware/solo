// Cloudflare Workers + Static Assets config for sws-worker-site (workers-rs).
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sws-worker-site",
	// worker-build (run inside crates/sws-worker-site) emits crates/sws-worker-site/build/index.js + index_bg.wasm.
	"main": "crates/sws-worker-site/build/index.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"build": {
		// Requires: cargo install worker-build@0.9.0 --locked (CI installs it; pin in wasm-toolchain.json).
		// The script skips Cargo/worker-build when the Rust inputs are unchanged (docs/WASM_TOOLCHAIN.md).
		"command": "node scripts/build-wasm.mjs --profile release",
		"watch_dir": "crates/sws-worker-site/src"
	},
	"assets": {
		// Rendered by `npm run render` (`solo build`); _headers applies the security headers.
		"directory": "./core/public",
		"binding": "ASSETS",
		// Only /api/* reaches the Worker first; everything else is served as a static asset.
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sws-demo",
			"migrations_dir": "crates/sws-worker-site/migrations",
			// Local placeholder ID; replace with your `wrangler d1 create` output before deploying.
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	// Optional events calendar (issue #43): only after provisioning the GOOGLE_*
	// secrets, applying the D1 migrations, and operator approval, uncomment:
	// "triggers": { "crons": ["*/30 * * * *"] },
	// Per-tenant/client-IP Workers rate limiter for GET /api/bookings/slots
	// (issue #44): 20 requests per minute at each Cloudflare location. Requires
	// the binding on every deployed environment; the edge-rate-limit caveat in
	// docs/SCHEDULING_SETUP.md still applies.
	"ratelimits": [{ "name": "BOOKING_SLOTS_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
	"vars": {
		"BUILD_VERSION": "0.1.0-dev",
		// Cloudflare Turnstile always-pass TEST site key. Replace per tenant in production.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		"RESEND_FROM": "Shirlington Hearth Demo <noreply@shirlington-hearth.example>",
		"INQUIRY_TO": "events@shirlington-hearth.example",
		// Pack-specific hospitality inquiry form schema (decoupled from core sws-worker-site defaults).
		"FORM_SCHEMAS_JSON": "{\"inquire\":{\"id\":\"inquire\",\"turnstile_action\":\"inquire\",\"fields\":[{\"name\":\"kind\",\"required\":true,\"kind\":{\"enum\":[\"private_event\",\"contact\"]}},{\"name\":\"name\",\"required\":true,\"kind\":{\"text\":{\"max_chars\":100,\"multiline\":false}}},{\"name\":\"email\",\"required\":true,\"kind\":\"email\"},{\"name\":\"phone\",\"required\":false,\"kind\":{\"phone\":{\"max_chars\":32}}},{\"name\":\"event_date\",\"required\":false,\"kind\":\"date\"},{\"name\":\"guest_count\",\"required\":false,\"kind\":{\"integer\":{\"min\":1,\"max\":1000}}},{\"name\":\"message\",\"required\":true,\"kind\":{\"text\":{\"max_chars\":4000,\"multiline\":true}}},{\"name\":\"source_route\",\"required\":true,\"kind\":{\"route\":{\"allowed\":[\"/book-an-event\",\"/contact\"]}}}]}}"
		// Optional defense-in-depth (issue #6): set ALLOWED_HOSTNAMES in production to a
		// comma-separated list of the exact hostnames siteverify should accept, e.g.
		//   "ALLOWED_HOSTNAMES": "www.example.com, example.com"
		// Leave it unset locally: `wrangler dev` reports 127.0.0.1:8787 and would fail the check.
	},
	// Secrets (never commit): set with `wrangler secret put <NAME>` in production,
	// or in .dev.vars for local `wrangler dev` (copy .dev.vars.example):
	//   TURNSTILE_SECRET_KEY  required; if missing the API answers 503 unless DEV_MODE="true".
	//     The always-pass TEST dummy secret is also rejected with 503 when DEV_MODE is
	//     unset (fail closed), so a prod deploy can never silently disable bot protection.
	//   RESEND_API_KEY        optional; if missing, email dispatch is stubbed ("resend stub: skipped")
	// Sandbox demo checkout (see docs/STRIPE_DEMO.md) — all optional; the demo
	// checkout fails closed (503) when any piece is missing:
	//   DEMO_CHECKOUT_ORIGIN  non-secret var: exact public origin of the site (no path);
	//                         loopback http is accepted for local testing only.
	//   STRIPE_DEMO_PRICE_IDS non-secret var: JSON object mapping demo item ids
	//                         (including the subscription) to sandbox Price ids.
	//   STRIPE_DEMO_SECRET_KEY secret: sandbox-only key (sk_test_/rk_test_ prefixes
	//                         only). The route is sandbox/test-mode by construction.
	// Call booking (issue #44; see docs/SCHEDULING_SETUP.md) — all optional;
	// /api/bookings is inert (404) without an enabled booking-config.json asset
	// and answers 503 fail-closed when the secrets below are missing:
	//   GOOGLE_BOOKING_CALENDAR_ID  primary calendar ID of the Workspace user mailbox
	//   ZOOM_ACCOUNT_ID, ZOOM_CLIENT_ID, ZOOM_CLIENT_SECRET, ZOOM_HOST_USER_ID
	//                         optional auto-Zoom meeting creation (auto_zoom)
	// Local-only var (in .dev.vars): DEV_MODE="true" skips Turnstile when no secret is set
	// and lets the TEST dummy secret pass for local development. Never set it in production.
	"observability": {
		"enabled": true
	}
}